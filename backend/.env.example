# TLMS Backend Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tlms
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tlms

# S4H Auth Service
S4H_AUTH_BASE_URL=http://api-auth.aisteamx.edu.vn

# Local development auth fallback for seeded/local users when S4H is unavailable
DEV_AUTH_FALLBACK_ENABLED=false
DEV_AUTH_PASSWORD=
DEV_AUTH_SECRET_KEY=
DEV_AUTH_ACCESS_TOKEN_MINUTES=1440
DEV_AUTH_REFRESH_TOKEN_DAYS=7

# Runtime process controls. Production runs the scheduler in a dedicated worker.
RUN_SCHEDULER=true
AUTO_CREATE_SCHEMA=true
WORKER_DB_WAIT_SECONDS=300

# LHU API
LHU_API_BASE_URL=https://tapi.lhu.edu.vn

# AI Daily Quest Generation
# AI_PROVIDER supports: openai, anthropic, gemini
AI_PROVIDER=openai
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini local/dev suggestion: gemini-3.6-flash
AI_MODEL=gemini-2.5-flash
DAILY_QUEST_LIMIT=5
DAILY_QUEST_RESET_HOUR=0
AI_AUTO_PASS_SCORE=70
UPLOAD_DIR=/app/uploads
QUEST_PROOF_UPLOAD_DIR=quest_proofs
MAX_UPLOAD_BYTES=5000000

# Weekly Cup Competition
# Monday=0, Friday=4. Default opens every Friday 00:00 Vietnam time.
WEEKLY_CUP_MIN_DISCIPLINE=80
WEEKLY_CUP_OPEN_WEEKDAY=4
WEEKLY_CUP_OPEN_HOUR=0
WEEKLY_CUP_DURATION_HOURS=24

# Zalo OA Daily Task Quiz
ZALO_INTEGRATION_ENABLED=false
ZALO_PROVIDER=mock
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_SEND_URL=https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_OA_TOKEN_URL=https://oauth.zaloapp.com/v4/oa/access_token
ZALO_WEB_APP_URL=https://your-domain.example
ZALO_LINK_TOKEN_MINUTES=15
ZALO_WEBHOOK_MAX_SKEW_SECONDS=300

# LHU MySQL (for Student ID Sync)
LHU_MYSQL_HOST=
LHU_MYSQL_PORT=3306
LHU_MYSQL_USER=
LHU_MYSQL_PASSWORD=
LHU_MYSQL_DATABASE=

# Webhook API Key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
WEBHOOK_API_KEY=
SCHEDULER_API_KEY=

# MongoDB (for User Import)
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=checkin_service
MONGODB_USERS_COLLECTION=users

# User Import Secret Token
USER_IMPORT_SECRET_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://tlms.talab.io.vn,https://tlms-backend.talab.io.vn

# Frontend
NEXT_PUBLIC_API_URL=/api

# Digital certification
PUBLIC_WEB_URL=http://localhost:3000
CERTIFICATE_STORAGE_DIR=/app/private/certificates
CERTIFICATE_ISSUER_NAME=T&A Lab
CERTIFICATE_VERIFY_RATE_LIMIT=30

# Durable object storage. Use s3 with a private Cloudflare R2 bucket in production.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
